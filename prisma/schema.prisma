generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  REVIEWER
  SUPPORT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum QuoteStatus {
  NEW
  REVIEWED
  QUOTED
  APPROVED
}

enum ProjectCategoryType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INFRASTRUCTURE
  CONSULTANCY
  RENOVATION
  OTHER
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PUBLISH
  ARCHIVE
  ASSIGN
  EXPORT
}

enum ContentType {
  PAGE
  SERVICE
  PROJECT
  NEWS_ARTICLE
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  username         String?           @unique
  fullName         String
  passwordHash     String            // Store only hashed passwords (e.g., Argon2/Bcrypt)
  isActive         Boolean           @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  authoredNews     NewsArticle[]
  pagesCreated     Page[]            @relation("PageCreatedBy")
  servicesCreated  Service[]         @relation("ServiceCreatedBy")
  projectsCreated  Project[]         @relation("ProjectCreatedBy")
  revisions        RevisionHistory[]
  auditLogs        AuditLog[]
  activityLogs     ActivityLog[]
  analyticsEvents  AnalyticsEvent[]
  reportExports    ReportExport[]
  userRoles        UserRole[]
  sessions         Session[]

  @@index([isActive, deletedAt])
  @@index([createdAt])
}

model Session {
  id               String            @id @default(cuid())
  userId           String
  tokenHash        String            @unique
  csrfTokenHash    String
  expiresAt        DateTime
  lastSeenAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  revokedAt        DateTime?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model Role {
  id               String            @id @default(cuid())
  key              RoleType          @unique
  name             String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  userRoles        UserRole[]
  rolePermissions  RolePermission[]
}

model Permission {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  rolePermissions  RolePermission[]

  @@index([key])
}

model UserRole {
  userId           String
  roleId           String
  assignedAt       DateTime          @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId           String
  permissionId     String
  assignedAt       DateTime          @default(now())

  role             Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission       Permission        @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Page {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  content          Json
  excerpt          String?
  status           ContentStatus     @default(DRAFT)
  publishedAt      DateTime?
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  createdById      String
  createdBy        User              @relation("PageCreatedBy", fields: [createdById], references: [id])
  seo              SeoMetadata?
  revisions        RevisionHistory[]

  @@index([status, publishedAt])
  @@index([slug, deletedAt])
  @@index([createdAt])
}

model Service {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  summary          String?
  content          Json
  status           ContentStatus     @default(DRAFT)
  publishedAt      DateTime?
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  createdById      String
  createdBy        User              @relation("ServiceCreatedBy", fields: [createdById], references: [id])
  seo              SeoMetadata?
  revisions        RevisionHistory[]

  @@index([status, publishedAt])
  @@index([slug, deletedAt])
  @@index([createdAt])
}

model Project {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  summary          String?
  description      Json
  location         String?
  completedOn      DateTime?
  status           ContentStatus     @default(DRAFT)
  publishedAt      DateTime?
  featured         Boolean           @default(false)
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  createdById      String
  createdBy        User              @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  seo              SeoMetadata?
  projectCategories ProjectCategory[]
  revisions        RevisionHistory[]

  @@index([status, featured, publishedAt])
  @@index([slug, deletedAt])
  @@index([completedOn])
}

model Category {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  type             ProjectCategoryType
  description      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  projectCategories ProjectCategory[]

  @@unique([name, type])
  @@index([type])
}

model ProjectCategory {
  projectId         String
  categoryId        String

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
  @@index([categoryId])
}

model NewsArticle {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  excerpt          String?
  body             Json
  coverImageUrl    String?
  status           ContentStatus     @default(DRAFT)
  publishedAt      DateTime?
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  authorId         String
  author           User              @relation(fields: [authorId], references: [id])
  seo              SeoMetadata?
  revisions        RevisionHistory[]

  @@index([status, publishedAt])
  @@index([authorId, createdAt])
  @@index([slug, deletedAt])
}

model Client {
  id               String            @id @default(cuid())
  name             String
  email            String
  phone            String?
  company          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  quoteRequests    QuoteRequest[]

  @@index([email])
}

model Inquiry {
  id               String            @id @default(cuid())
  name             String
  email            String
  phone            String?
  subject          String?
  message          String
  sourcePage       String?
  isResolved       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  @@index([email, createdAt])
  @@index([isResolved, createdAt])
}

model QuoteRequest {
  id               String            @id @default(cuid())
  clientId         String
  serviceType      String
  budgetMin        Decimal?          @db.Decimal(12, 2)
  budgetMax        Decimal?          @db.Decimal(12, 2)
  timeline         String?
  requirements     String
  status           QuoteStatus       @default(NEW)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  client           Client            @relation(fields: [clientId], references: [id])

  @@index([clientId, createdAt])
  @@index([status, createdAt])
}

model Settings {
  id               String            @id @default(cuid())
  key              String            @unique
  value            Json
  isPublic         Boolean           @default(false)
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([isPublic])
}

model SeoMetadata {
  id               String            @id @default(cuid())
  title            String?
  description      String?
  keywords         String[]
  canonicalUrl     String?
  ogImageUrl       String?
  noIndex          Boolean           @default(false)
  structuredData   Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  pageId           String?           @unique
  serviceId        String?           @unique
  projectId        String?           @unique
  newsArticleId    String?           @unique

  page             Page?             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  newsArticle      NewsArticle?      @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id               String            @id @default(cuid())
  userId           String
  action           LogAction
  entityType       String
  entityId         String
  metadata         Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime          @default(now())

  user             User              @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model ActivityLog {
  id               String            @id @default(cuid())
  userId           String?
  activityType     String
  message          String
  metadata         Json?
  createdAt        DateTime          @default(now())

  user             User?             @relation(fields: [userId], references: [id])

  @@index([activityType, createdAt])
  @@index([userId, createdAt])
}

model AnalyticsEvent {
  id               String            @id @default(cuid())
  eventName        String
  userId           String?
  path             String?
  metadata         Json?
  createdAt        DateTime          @default(now())

  user             User?             @relation(fields: [userId], references: [id])

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
}

model ReportExport {
  id               String            @id @default(cuid())
  requestedById    String
  reportType       String
  filters          Json?
  format           String
  fileUrl          String?
  status           String            @default("PENDING")
  createdAt        DateTime          @default(now())
  completedAt      DateTime?

  requestedBy      User              @relation(fields: [requestedById], references: [id])

  @@index([requestedById, createdAt])
  @@index([reportType, status])
}

model RevisionHistory {
  id               String            @id @default(cuid())
  contentType      ContentType
  revisionNumber   Int
  changeSummary    String?
  snapshot         Json
  createdAt        DateTime          @default(now())

  editorId         String
  pageId           String?
  serviceId        String?
  projectId        String?
  newsArticleId    String?

  editor           User              @relation(fields: [editorId], references: [id])
  page             Page?             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  newsArticle      NewsArticle?      @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)

  @@index([contentType, createdAt])
  @@index([pageId, revisionNumber])
  @@index([serviceId, revisionNumber])
  @@index([projectId, revisionNumber])
  @@index([newsArticleId, revisionNumber])
}
