# Runtime
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/divinerock"

# Auth / session security
AUTH_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
AUTH_SESSION_TTL_MINUTES=480
AUTH_IDLE_TIMEOUT_MINUTES=30
AUTH_COOKIE_NAME=dr_session
AUTH_CSRF_COOKIE_NAME=dr_csrf
AUTH_REQUIRE_2FA=false

# Login abuse protection
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_LOGIN_LOCKOUT_THRESHOLD=5
AUTH_LOGIN_LOCKOUT_MS=900000

# CAPTCHA (optional)
AUTH_CAPTCHA_ENABLED=false
AUTH_CAPTCHA_SECRET=

# Outbound request allowlists (comma-separated)
SECURITY_ALLOWED_OUTBOUND_HOSTS=api.cloudinary.com,res.cloudinary.com

# Local default; override in production env with your real HTTPS domain
NEXT_PUBLIC_APP_URL=http://localhost:3000